<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Data_Quality_Detail__c</fullName>
    <description>BR-02. Names which routing-critical attributes are missing, so an incomplete record explains itself.</description>
    <externalId>false</externalId>
    <formula><![CDATA[IF(AND(NOT(ISBLANK(TEXT(CountryCode))), NOT(ISBLANK(NumberOfEmployees))), "None", "Missing: " & TRIM(IF(ISBLANK(TEXT(CountryCode)), "Country ", "") & IF(ISBLANK(NumberOfEmployees), "EmployeeCount", "")))]]></formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <inlineHelpText>Which routing-critical attributes are missing on this record.</inlineHelpText>
    <label>Data Quality Detail</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
