<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>BR-12/BR-13. Leads needing intervention now: At Risk or Breached. Excluded and Unmeasurable are deliberately absent - they are not seller response failures.</description>
    <filter>
        <criteriaItems>
            <column>Lead.SLA_Status__c</column>
            <operator>contains</operator>
            <value>At Risk,Breached</value>
        </criteriaItems>
    </filter>
    <format>Tabular</format>
    <name>NIQ Open SLA Risk</name>
    <reportType>LeadList</reportType>
    <showDetails>true</showDetails>
    <columns><field>Lead.Segment__c</field></columns>
    <columns><field>Lead.Territory__c</field></columns>
    <columns><field>Lead.SLA_Status__c</field></columns>
    <columns><field>Lead.SLA_Target_DateTime__c</field></columns>
    <columns><field>Lead.SLA_Basis__c</field></columns>
</Report>
