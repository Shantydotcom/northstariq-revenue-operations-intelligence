# =============================================================================
# NorthstarIQ - Revenue Operations Intelligence Platform
# .gitignore
#
# Governing rule: this repository is PUBLIC portfolio evidence.
# Nothing that authenticates, identifies a real person, or reveals an org
# may ever be committed. When in doubt, ignore it.
# See also: .forceignore (controls Salesforce deploy/retrieve, NOT git).
# =============================================================================

# -----------------------------------------------------------------------------
# CRITICAL - Salesforce authentication & org artifacts
# `sf org login` writes tokens under .sf/ ; the legacy CLI used .sfdx/
# These contain refresh tokens that grant full org access.
# -----------------------------------------------------------------------------
.sf/
.sfdx/
.sfdx-*/
.localdevserver/
sfdx.auth
**/sfdx-auth-url*
**/*authurl*
**/*auth-url*
**/*.sfdxAuthUrl
alias.json
key.json

# JWT / connected-app credentials used for CI org auth
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
server.key*
assets/certificates/

# -----------------------------------------------------------------------------
# CRITICAL - secrets, tokens, credentials
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
secrets.*
credentials.*
*credential*
*secret*
*password*
*token*
!**/docs/**/*token*
.netrc
_netrc
.npmrc
.pypirc
.gh-token
gh-token*

# -----------------------------------------------------------------------------
# CRITICAL - real or exported org data
# All committed data in this repository must be SYNTHETIC and fictional.
# Ad-hoc exports are ignored by default; deliberate synthetic fixtures are
# force-added under data/ and tests/fixtures/ after review.
# -----------------------------------------------------------------------------
*export*.csv
*extract*.csv
*backup*.csv
dataloader/
DataLoader/
*.dataloader.log
sdl.csv
success*.csv
error*.csv
*_success.csv
*_error.csv

# -----------------------------------------------------------------------------
# Salesforce CLI / DX working artifacts
# -----------------------------------------------------------------------------
.sfdx-lwc-jest/
deploy-options.json
*.retrieve.zip
*.deploy.zip
retrieveUnpackaged/
mdapiout/
mdapi_output_dir/
force-app-retrieved/
.scratch-org-*
scratch-def.local.json

# Salesforce CLI logs
sf.log
sfdx.log
*.sf.log
.sf-cache/

# -----------------------------------------------------------------------------
# Node / npm
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.yarn/
.eslintcache
coverage/
.nyc_output/

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.virtualenv/
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.tox/
pip-log.txt

# -----------------------------------------------------------------------------
# PowerShell
# -----------------------------------------------------------------------------
*.ps1xml.bak
PSReadLine*
*.psd1.bak

# -----------------------------------------------------------------------------
# Power BI
# .pbix is a binary containing a cached data model - it can embed synthetic
# data AND, if ever connected to a live org, credentials and real rows.
# Model definitions are version-controlled as TEXT (.tmdl / .bim / .pq / .dax)
# under powerbi/, not as binaries.
# -----------------------------------------------------------------------------
*.pbix
*.pbit
*.pbip.local/
.pbi/
*.SemanticModel/.pbi/localSettings.json
*.Report/.pbi/localSettings.json
*.abf

# -----------------------------------------------------------------------------
# Windows
# -----------------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# -----------------------------------------------------------------------------
# macOS / Linux (contributors may differ)
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
*~
.directory
.fuse_hidden*
.nfs*

# -----------------------------------------------------------------------------
# Editors / IDE
# .vscode/ is NOT fully ignored: shared workspace settings and the extension
# recommendations list are useful portfolio evidence of the engineering setup.
# Only per-user and secret-bearing files are excluded.
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.vscode/sfdx-hardis.*
.vs/
.idea/
*.suo
*.user
*.sln.docstates
*.swp
*.swo
*.iml

# -----------------------------------------------------------------------------
# Local / temporary / scratch
# -----------------------------------------------------------------------------
tmp/
temp/
.tmp/
scratch/
scratchpad/
*.tmp
*.bak
*.orig
*.rej
*.log
logs/
.cache/
*.local
*.local.*
local-*
LOCAL_*
NOTES.local.md

# -----------------------------------------------------------------------------
# Diagram render output
# D2 SOURCE (.d2) is committed - it is the reviewable artifact.
# Rendered SVG is committed deliberately (README embedding) via force-add.
# Everything else rendered is derived output and stays out.
# -----------------------------------------------------------------------------
docs/architecture/*.png
docs/architecture/*.pdf
docs/architecture/render/
*.d2.tmp

# -----------------------------------------------------------------------------
# Archives & binaries (avoid accidental large/opaque commits)
# -----------------------------------------------------------------------------
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.iso
*.dmg
*.exe
*.msi
*.dll
