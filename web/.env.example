# NorthstarIQ -> Salesforce Developer Edition (server-side only)
#
# PLACEHOLDERS ONLY. Never commit real values.
# .env and .env.local are git-ignored; this example file is tracked deliberately.
#
# These are read exclusively in server-side modules. They are intentionally NOT
# prefixed with NEXT_PUBLIC_, so Next.js will never inline them into the browser
# bundle. Adding that prefix would leak the secret to every visitor.

# Login host for the Developer Edition org.
# Use the org's My Domain URL, e.g. https://your-domain.my.salesforce.com
SF_LOGIN_URL=https://login.salesforce.com

# Connected App consumer key / secret (OAuth 2.0 Client Credentials Flow).
SF_CLIENT_ID=your_connected_app_consumer_key
SF_CLIENT_SECRET=your_connected_app_consumer_secret

# Salesforce REST API version, without the leading "v".
SF_API_VERSION=67.0
